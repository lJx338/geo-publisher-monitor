{
  "name": "geo-publisher-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Developer-only health monitor for GEO Publisher platform adapters",
  "author": "Lingxi",
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && electron .",
    "pretest": "node node_modules/electron/install.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "npm run build && node tests/electron-smoke.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "package:mac": "npm run build && electron-builder --mac --arm64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pngjs": "^7.0.0",
    "semver": "^7.7.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/pngjs": "^6.0.5",
    "@types/semver": "^7.7.1",
    "electron": "43.1.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.1",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vitest": "^4.0.16",
    "yaml": "^2.8.1"
  },
  "build": {
    "appId": "com.lingxi.geo-publisher-monitor",
    "productName": "GEO Publisher Monitor",
    "asar": true,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://lingxi-1303034624.cos.ap-guangzhou.myqcloud.com/geo-publisher-monitor/releases/channels/stable/mac-arm64"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
